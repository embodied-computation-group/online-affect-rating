# Gitignored. Create a token at https://app.prolific.com/researcher/tokens/
PROLIFIC_TOKEN=<your token>
# PROLIFIC_URL=https://api.prolific.com
# Optional default workspace/project ids
PROLIFIC_WORKSPACE=
PROLIFIC_PROJECT=

# JATOS (MindProbe). Create a token in JATOS: your name (top right) -> My API tokens -> New token
JATOS_URL=https://jatos.mindprobe.eu
JATOS_TOKEN=<your jatos token>
# The JATOS study id goes in the study file (jatos: study_id:); set it here only as a fallback.
JATOS_STUDY_ID=
